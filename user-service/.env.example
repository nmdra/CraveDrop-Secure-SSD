NODE_ENV=development
PORT=3000
DB_USER=postgres
DB_PASS=local-only-postgres-password
DB_NAME=cravedrop_db
DB_HOST=postgres
JWT_SECRET=generate-a-local-access-secret
JWT_REFRESH_SECRET=generate-a-local-refresh-secret
JWT_EXPIRE=1h
FRONTEND_ORIGIN=http://localhost:5173
OIDC_DISCOVERY_URL=https://localhost:9443/oauth2/token/.well-known/openid-configuration
OIDC_ISSUER=https://localhost:9443/oauth2/token
OIDC_CLIENT_ID=register-in-wso2-locally
OIDC_CLIENT_SECRET=inject-at-runtime
OIDC_REDIRECT_URI=http://localhost:3001/api/user/auth/wso2/callback
OIDC_SUCCESS_REDIRECT_URI=http://localhost:5173/dashboard
OIDC_FLOW_SECRET=generate-a-local-oidc-flow-secret
